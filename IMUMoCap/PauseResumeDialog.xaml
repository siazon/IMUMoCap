<Window
    x:Class="IMUMoCap.PauseResumeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Resume"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    ShowInTaskbar="False">

    <StackPanel Margin="16" Width="360">
        <TextBlock x:Name="txtDuration" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <TextBlock Text="Pause reason (required):" FontSize="11" Margin="0,0,0,4"/>
        <TextBox x:Name="txtReason" Margin="0,0,0,4"/>
        <TextBlock x:Name="txtError" Text="Reason is required."
                   Foreground="Red" FontSize="11" Visibility="Collapsed" Margin="0,0,0,8"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Continue" Click="BtnContinue_Click" Padding="10,4" Margin="0,0,8,0"/>
            <Button Content="Redo Stage" Click="BtnRedo_Click" Padding="10,4"/>
        </StackPanel>
    </StackPanel>
</Window>
