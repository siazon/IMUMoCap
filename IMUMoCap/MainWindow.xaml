<Window
    x:Class="IMUMoCap.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:IMUMoCap"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="IMUMoCap"
    Width="1280"
    Height="800"
    Style="{StaticResource MaterialDesignWindow}"
    WindowState="Maximized"
    mc:Ignorable="d">

    <!-- Root: brand header bar on top, single left panel below -->
    <DockPanel LastChildFill="True">

        <!-- ── HEADER BAR — app identity (global, always visible) ── -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Brand.Navy}" Height="44">
            <TextBlock Text="IMUMoCap" Foreground="White" FontSize="16" FontWeight="Bold"
                       Margin="16,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
        </Border>

        <!-- ── LEFT PANEL — Grid with resizable log row ─────────────────────── -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Row 0: Session card + Left/Right FPA -->
                <RowDefinition Height="Auto"/>
                <!-- Row 1: status bar (full width) -->
                <RowDefinition Height="Auto"/>
                <!-- Row 2: timeline -->
                <RowDefinition x:Name="SplitterRow" Height="5"/>
                <!-- Row 3: drag handle -->
                <RowDefinition x:Name="LogRow" Height="*" MinHeight="60"/>
                <!-- Row 4: log (now gets all freed space) -->
            </Grid.RowDefinitions>

            <!-- Row 0: Session (top-left) + Left FPA + Right FPA -->
            <Grid Grid.Row="0" Margin="8,6,8,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- ── Experiment Session (Tools folded in, Parameters moved to popup) ── -->
                <!-- Fixed width (12 padding + 1 border on each side + 512 content = 4x(120 button + 8 gap), no slack)
                     so the button rows keep a consistent gap and never drift when the window is resized. -->
                <Border Grid.Column="0" Width="538" Padding="12" CornerRadius="8"
                        BorderBrush="{StaticResource Brand.MintMid}" BorderThickness="1"
                        VerticalAlignment="Top" Margin="0,0,4,0">
                    <StackPanel>
                        <TextBlock Text="Experiment Session" FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource Brand.Navy}" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,10">
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Participant ID:" Style="{StaticResource CaptionTextStyle}"/>
                                <TextBox x:Name="txtParticipantId" Style="{StaticResource BrandTextBoxStyle}" Width="130"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Condition:" Style="{StaticResource CaptionTextStyle}"/>
                                <ComboBox x:Name="cmbCondition" Style="{StaticResource BrandComboBoxStyle}" Width="70" SelectedIndex="0">
                                    <ComboBoxItem Content="EF"/>
                                    <ComboBoxItem Content="IF"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Order Group:" Style="{StaticResource CaptionTextStyle}"/>
                                <ComboBox x:Name="cmbOrderGroup" Style="{StaticResource BrandComboBoxStyle}" Width="70" SelectedIndex="0">
                                    <ComboBoxItem Content="A"/>
                                    <ComboBoxItem Content="B"/>
                                </ComboBox>
                            </StackPanel>
                            <Button Style="{StaticResource PrimaryButtonStyle}" Click="BtnStartCondition_Click" Width="120" Margin="0,0,0,0">
                                <TextBlock Text="Start Condition" TextWrapping="Wrap" TextAlignment="Center"/>
                            </Button>
                        </StackPanel>

                        <UniformGrid Columns="4" Rows="1" Margin="0,0,0,8">
                            <Button Style="{StaticResource PrimaryButtonStyle}" Click="BtnStartWashout_Click" Width="120">
                                <TextBlock Text="Start Washout" TextWrapping="Wrap" TextAlignment="Center"/>
                            </Button>
                            <Button Style="{StaticResource SecondaryButtonStyle}" Click="BtnNextStage_Click" Width="120"
                                    ToolTip="Manual override — only needed if auto-advance doesn't trigger">
                                <TextBlock Text="Next Stage" TextWrapping="Wrap" TextAlignment="Center"/>
                            </Button>
                            <Button Style="{StaticResource PrimaryButtonStyle}" Click="BtnEndCondition_Click" Width="120"
                                    ToolTip="End condition/washout recording and close the session file">
                                <TextBlock Text="End Recording" TextWrapping="Wrap" TextAlignment="Center"/>
                            </Button>
                            <Button x:Name="BtnPauseResume" Style="{StaticResource PrimaryButtonStyle}" Click="BtnPauseResume_Click" Width="120">Pause</Button>
                        </UniformGrid>

                        <TextBlock Margin="0,0,0,4">
                            <Run Text="Stage: " Foreground="Gray"/><Run Text="{Binding CurrentStageLabel}" FontWeight="SemiBold" Foreground="{StaticResource Brand.Navy}"/>
                            <Run Text="  Elapsed: " Foreground="Gray"/><Run Text="{Binding StageElapsedDisplay}" Foreground="{StaticResource Brand.Navy}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding TurningExclusionDisplay}" FontSize="12" Opacity="0.7"
                                    Foreground="{StaticResource Brand.Navy}" Margin="0,0,0,4"/>

                        <TextBlock Text="Session file:" Style="{StaticResource CaptionTextStyle}"/>
                        <TextBlock Text="{Binding CurrentSessionFileName}" FontSize="11" Foreground="{StaticResource Brand.Navy}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                        <TextBlock Text="Meta file:" Style="{StaticResource CaptionTextStyle}"/>
                        <TextBlock Text="{Binding CurrentMetaFileName}" FontSize="11" Foreground="{StaticResource Brand.Navy}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                        <TextBlock Text="QoE file (fill in externally):" Style="{StaticResource CaptionTextStyle}"/>
                        <TextBlock Text="{Binding CurrentQoeFileName}" FontSize="11" Foreground="{StaticResource Brand.Navy}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <!-- ── Tools (folded into Session) ──────────────────────────── -->
                        <TextBlock Text="Tools" FontWeight="Bold" FontSize="12" Foreground="{StaticResource Brand.Navy}" Margin="0,4,0,6"/>

                        <UniformGrid Columns="4" Margin="0,0,0,4">
                            <Button x:Name="BtnStartCal" Style="{StaticResource PrimaryButtonStyle}" Click="BtnStartCal_Click"
                                    Width="120" ToolTip="Reset pipeline and immediately start calibration">
                                <TextBlock Text="Start Calibration" TextWrapping="Wrap" TextAlignment="Center"/>
                            </Button>
                            <Button x:Name="BtnMeasure" Style="{StaticResource PrimaryButtonStyle}" Click="BtnMeasure_Click" Width="120">
                                <TextBlock x:Name="BtnMeasureLabel" Text="▶ Measure" TextWrapping="Wrap" TextAlignment="Center"/>
                            </Button>
                            <Button Style="{StaticResource SecondaryButtonStyle}" Click="Button_SaveData" Width="120">
                                <TextBlock Text="Save IMU Samples" TextWrapping="Wrap" TextAlignment="Center"/>
                            </Button>
                            <Button x:Name="BtnSaveDiagnostics" Style="{StaticResource SecondaryButtonStyle}" Click="BtnSaveDiagnostics_Click"
                                    Width="120" ToolTip="Export diagnostics to CSV for AI analysis">
                                <TextBlock Text="Save Diagnostics" TextWrapping="Wrap" TextAlignment="Center"/>
                            </Button>
                        </UniformGrid>

                        <!-- Parameters, Load IMU Samples, and replay controls (visible only during replay) share one row -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Button x:Name="BtnOpenParams" Style="{StaticResource SecondaryButtonStyle}" Click="BtnOpenParams_Click"
                                    Width="120" ToolTip="Open pipeline parameter settings">
                                Parameters...
                            </Button>
                            <Button x:Name="BtnLoadData" Style="{StaticResource SecondaryButtonStyle}" Click="BtnLoadData_Click"
                                    Width="120" ToolTip="Load IMU samples CSV and replay through pipeline">
                                <TextBlock Text="Load IMU Samples" TextWrapping="Wrap" TextAlignment="Center"/>
                            </Button>
                            <StackPanel x:Name="ReplayControls" Orientation="Horizontal" Visibility="Collapsed">
                                <Button Style="{StaticResource SecondaryButtonStyle}" Click="BtnReplaySlower_Click" Width="60" FontSize="16" ToolTip="Slow down replay">⏪</Button>
                                <Button x:Name="BtnReplayPause" Style="{StaticResource SecondaryButtonStyle}" Click="BtnReplayPause_Click" Width="60" FontSize="16" ToolTip="Pause / Resume">⏸</Button>
                                <Button Style="{StaticResource SecondaryButtonStyle}" Click="BtnReplayFaster_Click" Width="60" FontSize="16" ToolTip="Speed up replay">⏩</Button>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Left FPA — key info, given more room and visual weight -->
                <Border Grid.Column="1" Padding="12" CornerRadius="8"
                        Background="{Binding LeftFpaBackground}" Margin="4,0">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Left FPA" FontSize="13" Opacity="0.75" HorizontalAlignment="Center"
                                   Foreground="{StaticResource Brand.Navy}"/>
                        <TextBlock Text="{Binding LeftFpaDeg, StringFormat={}{0:F1}°}"
                                   FontSize="40" FontWeight="Bold" HorizontalAlignment="Center"
                                   Foreground="{StaticResource Brand.Navy}"/>
                        <TextBlock Text="{Binding LeftFpaTarget}" FontSize="13" Opacity="0.85" HorizontalAlignment="Center"
                                   Foreground="{StaticResource Brand.Navy}"/>
                        <TextBlock Text="{Binding LeftFpaNote}" FontSize="12" Opacity="0.75" HorizontalAlignment="Center"
                                   Foreground="{StaticResource Brand.Navy}"/>
                    </StackPanel>
                </Border>

                <!-- Right FPA — key info, given more room and visual weight -->
                <Border Grid.Column="2" Padding="12" CornerRadius="8"
                        Background="{Binding RightFpaBackground}" Margin="4,0,0,0">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Right FPA" FontSize="13" Opacity="0.75" HorizontalAlignment="Center"
                                   Foreground="{StaticResource Brand.Navy}"/>
                        <TextBlock Text="{Binding RightFpaDeg, StringFormat={}{0:F1}°}"
                                   FontSize="40" FontWeight="Bold" HorizontalAlignment="Center"
                                   Foreground="{StaticResource Brand.Navy}"/>
                        <TextBlock Text="{Binding RightFpaTarget}" FontSize="13" Opacity="0.85" HorizontalAlignment="Center"
                                   Foreground="{StaticResource Brand.Navy}"/>
                        <TextBlock Text="{Binding RightFpaNote}" FontSize="12" Opacity="0.75" HorizontalAlignment="Center"
                                   Foreground="{StaticResource Brand.Navy}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Row 1: Status bar — full width, moved above the timeline -->
            <Border Grid.Row="1" Padding="10" CornerRadius="8"
                    BorderBrush="{StaticResource Brand.MintMid}" BorderThickness="1" Margin="8,0,8,8">
                <StackPanel Orientation="Horizontal">
                    <!-- IMU connection status — color conveys connected/disconnected, so the label is role-only -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,24,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                            <Ellipse x:Name="PelvisStatusDot" Width="16" Height="16" Fill="Gray"
                                     Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="PelvisStatusText" Text="Pelvis" FontSize="12" Foreground="{StaticResource Brand.Navy}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                            <Ellipse x:Name="LeftStatusDot" Width="16" Height="16" Fill="Gray"
                                     Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LeftStatusText" Text="Left" FontSize="12" Foreground="{StaticResource Brand.Navy}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="RightStatusDot" Width="16" Height="16" Fill="Gray"
                                     Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="RightStatusText" Text="Right" FontSize="12" Foreground="{StaticResource Brand.Navy}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel MinWidth="180" Margin="0,0,24,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusLabel}" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource Brand.Navy}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Calib State:" Style="{StaticResource CaptionTextStyle}"/>
                            <TextBlock Text="{Binding CalibrationState}" FontSize="12" Foreground="{StaticResource Brand.Navy}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Prog Dir:" Style="{StaticResource CaptionTextStyle}"/>
                            <TextBlock Text="{Binding ProgDirDeg, StringFormat={}{0:F1}°}" FontSize="12" Foreground="{StaticResource Brand.Navy}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Gate Reject:" Style="{StaticResource CaptionTextStyle}"/>
                            <TextBlock Text="{Binding PelvisRejectStreak}" FontSize="12" Foreground="{StaticResource Brand.Navy}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Gait:" Style="{StaticResource CaptionTextStyle}"/>
                            <TextBlock Text="{Binding StanceSummary}" FontSize="12" Foreground="{StaticResource Brand.Navy}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Row 2: Timeline panel — dark chrome echoes the header bar -->
            <Border Grid.Row="2" x:Name="TimelineBorder" Background="{StaticResource Brand.Navy}" Margin="0,10,0,0"
                    SizeChanged="TimelineBorder_SizeChanged">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Top">
                        <TextBlock Text="PdValid"  Foreground="#888" Height="16" VerticalAlignment="Center" Margin="2,0"/>
                        <TextBlock Text="L.Stance" Foreground="#888" Height="16" VerticalAlignment="Center" Margin="2,0"/>
                        <TextBlock Text="R.Stance" Foreground="#888" Height="16" VerticalAlignment="Center" Margin="2,0"/>
                        <TextBlock Text="Walking"  Foreground="#888" Height="16" VerticalAlignment="Center" Margin="2,0"/>
                        <TextBlock Text="MotionCtx" Foreground="#888" Height="16" VerticalAlignment="Center" Margin="2,0"/>
                        <TextBlock Text="FPA"      Foreground="#888" Height="16" VerticalAlignment="Center" Margin="2,0"/>
                    </StackPanel>
                    <Image x:Name="TimelineImage" Grid.Column="1"
                           Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                </Grid>
            </Border>

            <!-- Row 3: GridSplitter — drag up/down to resize log -->
            <GridSplitter Grid.Row="3"
                          Height="5"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{StaticResource Brand.MintMid}"
                          ShowsPreview="True"
                          ResizeDirection="Rows"
                          ResizeBehavior="PreviousAndNext"
                          Visibility="{Binding LogPanelVisible, Converter={StaticResource BoolToVis}}"/>

            <!-- Row 4: Log panel — left: debug log, right: AR feedback event log (cue + timestamp) -->
            <Grid Grid.Row="4" Visibility="{Binding LogPanelVisible, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" BorderBrush="{StaticResource Brand.MintMid}" BorderThickness="1" CornerRadius="4" Margin="8,0,4,2">
                    <DockPanel Margin="6">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Debug Log" FontSize="12" Foreground="{StaticResource Brand.Navy}" Opacity="0.7" VerticalAlignment="Center"/>
                            <Button Click="btnClear" Width="24" Height="24" Padding="0" Margin="8,0,0,0"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="{StaticResource Brand.Navy}" Opacity="0.5"
                                    FontSize="13" ToolTip="Clear log">🧹</Button>
                        </StackPanel>
                        <TextBox
                            x:Name="LogBox"
                            AcceptsReturn="True"
                            IsReadOnly="True"
                            Text="{Binding LogList}"
                            TextWrapping="NoWrap"
                            FontFamily="Consolas"
                            FontSize="12"
                            BorderThickness="0"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Auto"/>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Column="1"
                              Width="5"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="{StaticResource Brand.MintMid}"
                              ShowsPreview="True"/>

                <Border Grid.Column="2" BorderBrush="{StaticResource Brand.MintMid}" BorderThickness="1" CornerRadius="4" Margin="4,0,8,2">
                    <DockPanel Margin="6">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="AR Feedback Events (cue + timestamp)" FontSize="12" Foreground="{StaticResource Brand.Navy}" Opacity="0.7" VerticalAlignment="Center"/>
                            <Button Click="BtnClearArLog_Click" Width="24" Height="24" Padding="0" Margin="8,0,0,0"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="{StaticResource Brand.Navy}" Opacity="0.5"
                                    FontSize="13" ToolTip="Clear log">🧹</Button>
                        </StackPanel>
                        <TextBox
                            x:Name="ArEventLogBox"
                            AcceptsReturn="True"
                            IsReadOnly="True"
                            Text="{Binding ArEventLog}"
                            TextWrapping="NoWrap"
                            FontFamily="Consolas"
                            FontSize="12"
                            BorderThickness="0"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Auto"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
