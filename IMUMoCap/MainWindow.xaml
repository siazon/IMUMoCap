<Window
    x:Class="IMUMoCap.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:h="http://helix-toolkit.org/wpf"
    xmlns:local="clr-namespace:IMUMoCap"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="800"
    Height="450"
    Style="{StaticResource MaterialDesignWindow}"
    WindowState="Maximized"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="8*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <Button Click="Button_Click">Connect</Button>
            <TextBlock Text="{Binding DeviceState}" />
        </StackPanel>
        <GridSplitter
            Grid.RowSpan="5"
            Grid.Column="1"
            Width="3"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            ShowsPreview="True" />
        <CheckBox Grid.Column="2" IsChecked="{Binding IsScollerToEnd}">Scroll To End</CheckBox>
        <TextBox
            x:Name="LogBox"
            Grid.Row="1"
            Grid.Column="2"
            AcceptsReturn="True"
            IsReadOnly="True"
            Text="{Binding LogList}"
            TextWrapping="Wrap" />
        <Grid Grid.Row="2">
            <h:HelixViewport3D
                x:Name="viewport"
                ShowCoordinateSystem="True"
                ShowFrameRate="True">
                <h:DefaultLights />
                <!--  一个表示设备的盒子（BoxVisual3D）  -->
                <h:BoxVisual3D
                    x:Name="deviceBox"
                    Width="1"
                    Height="0.2"
                    Center="0,0,0"
                    Fill="LightBlue"
                    Length="0.5"
                    Transform="{Binding Transform3D}" />
                <!--  一个代表前方向的箭头便于观察  -->
                <!--<h:ArrowVisual3D
                    x:Name="forwardArrow"
                    Diameter="0.05"
                    Point1="0,0,0"
                    Point2="0,0.8,0"
                    Transform="{Binding Transform3D}" />-->
            </h:HelixViewport3D>
        </Grid>

    </Grid>
</Window>
