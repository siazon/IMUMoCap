<Window
    x:Class="IMUMoCap.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:IMUMoCap"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="IMUMoCap"
    Width="1280"
    Height="800"
    Style="{StaticResource MaterialDesignWindow}"
    WindowState="Maximized"
    mc:Ignorable="d">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="CoreButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Background" Value="#1976D2"/>
            <Setter Property="BorderBrush" Value="#1976D2"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="CalibrationButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Background" Value="#F57C00"/>
            <Setter Property="BorderBrush" Value="#F57C00"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="ToolsButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Background" Value="#5E35B1"/>
            <Setter Property="BorderBrush" Value="#5E35B1"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="ParamsButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Background" Value="#388E3C"/>
            <Setter Property="BorderBrush" Value="#388E3C"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>

    <!-- Root: right panel (fixed 270px) | left panel (flex) -->
    <DockPanel LastChildFill="True">

        <!-- ── RIGHT PANEL ──────────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Right" Width="270"
                BorderBrush="#22000000" BorderThickness="1,0,0,0"
                Background="#F5F5F5">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12">

                    <!-- ── CORE: Experiment Session (always visible) ───────────────── -->
                    <Border Background="#E3F2FD" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Experiment Session" FontWeight="Bold" Margin="0,0,0,8"/>

                            <TextBlock Text="Participant ID:" FontSize="11" Opacity="0.7"/>
                            <TextBox x:Name="txtParticipantId" Margin="0,0,0,6"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="Condition:" FontSize="11" Opacity="0.7"/>
                                    <ComboBox x:Name="cmbCondition" Width="70" SelectedIndex="0">
                                        <ComboBoxItem Content="EF"/>
                                        <ComboBoxItem Content="IF"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Order Group:" FontSize="11" Opacity="0.7"/>
                                    <ComboBox x:Name="cmbOrderGroup" Width="70" SelectedIndex="0">
                                        <ComboBoxItem Content="A"/>
                                        <ComboBoxItem Content="B"/>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>

                            <Button Style="{StaticResource CoreButtonStyle}" Click="BtnStartCondition_Click" HorizontalAlignment="Stretch" Margin="0,0,0,4">Start Condition</Button>
                            <Button Style="{StaticResource CoreButtonStyle}" Click="BtnStartWashout_Click" HorizontalAlignment="Stretch" Margin="0,0,0,4">Start Washout</Button>
                            <Button Style="{StaticResource CoreButtonStyle}" Click="BtnNextStage_Click" HorizontalAlignment="Stretch" Margin="0,0,0,4">Next Stage</Button>
                            <Button Style="{StaticResource CoreButtonStyle}" Click="BtnEndCondition_Click" HorizontalAlignment="Stretch" Margin="0,0,0,8">End / Close File</Button>

                            <TextBlock Margin="0,0,0,4">
                                <Run Text="Stage: " Foreground="Gray"/><Run Text="{Binding CurrentStageLabel}" FontWeight="SemiBold"/>
                                <Run Text="  Elapsed: " Foreground="Gray"/><Run Text="{Binding StageElapsedDisplay}"/>
                            </TextBlock>
                            <TextBlock Text="{Binding TurningExclusionDisplay}" FontSize="11" Foreground="Gray" Margin="0,0,0,4"/>

                            <TextBlock Text="Session file:" FontSize="11" Opacity="0.7"/>
                            <TextBlock Text="{Binding CurrentSessionFileName}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <TextBlock Text="Meta file:" FontSize="11" Opacity="0.7"/>
                            <TextBlock Text="{Binding CurrentMetaFileName}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <TextBlock Text="QoE file (fill in externally):" FontSize="11" Opacity="0.7"/>
                            <TextBlock Text="{Binding CurrentQoeFileName}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,8"/>

                            <Button x:Name="BtnPauseResume" Style="{StaticResource CoreButtonStyle}" Click="BtnPauseResume_Click"
                                    HorizontalAlignment="Stretch">Pause</Button>
                        </StackPanel>
                    </Border>

                    <!-- ── Calibration (always visible, not collapsible) ───────────── -->
                    <Border Background="#FFF3E0" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Calibration" FontWeight="Bold" Margin="0,0,0,8"/>
                            <Button x:Name="BtnRestartCal" Style="{StaticResource CalibrationButtonStyle}" Click="BtnRestartCal_Click"
                                    HorizontalAlignment="Stretch"
                                    ToolTip="Reset pipeline and wait for stomp to re-calibrate">
                                Restart Calibration
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- ── Tools: legacy + diagnostics (collapsible) ────────────────── -->
                    <Border Background="#EDE7F6" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                        <StackPanel>
                            <Expander Header="Tools" IsExpanded="{Binding ToolsVisible, Mode=TwoWay}">
                                <StackPanel Margin="0,8,0,0">
                                    <Button Style="{StaticResource ToolsButtonStyle}" Click="BtnMeasure_Click" HorizontalAlignment="Stretch" Margin="0,0,0,4">Measure</Button>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="Sample Hz:" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="11"/>
                                        <TextBox x:Name="txtSampleRate" Width="50" Height="24" Text="10"/>
                                    </StackPanel>
                                    <Button Style="{StaticResource ToolsButtonStyle}" Click="Button_SaveData" HorizontalAlignment="Stretch" Margin="0,0,0,8">Save IMU Samples</Button>

                                    <Button x:Name="BtnSaveDiagnostics" Style="{StaticResource ToolsButtonStyle}" Click="BtnSaveDiagnostics_Click"
                                            HorizontalAlignment="Stretch" Margin="0,0,0,4"
                                            ToolTip="Export diagnostics to CSV for AI analysis">
                                        Save Diagnostics (CSV)
                                    </Button>

                                    <Button x:Name="BtnLoadData" Style="{StaticResource ToolsButtonStyle}" Click="BtnLoadData_Click"
                                            HorizontalAlignment="Stretch"
                                            ToolTip="Load IMU samples CSV and replay through pipeline">
                                        Load IMU Samples (CSV)
                                    </Button>
                                </StackPanel>
                            </Expander>
                            <!-- Replay controls — visible only during replay -->
                            <StackPanel x:Name="ReplayControls" Visibility="Collapsed" Margin="0,8,0,0">
                                <Button x:Name="BtnReplayPause" Style="{StaticResource ToolsButtonStyle}" Click="BtnReplayPause_Click"
                                        HorizontalAlignment="Stretch" Margin="0,0,0,4">⏸ Pause</Button>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource ToolsButtonStyle}" Click="BtnReplaySpeed_Click" Tag="50"  Width="56" Margin="0,0,2,0" ToolTip="0.2× real-time">Slow</Button>
                                    <Button Style="{StaticResource ToolsButtonStyle}" Click="BtnReplaySpeed_Click" Tag="10"  Width="56" Margin="0,0,2,0" ToolTip="1× real-time">1×</Button>
                                    <Button Style="{StaticResource ToolsButtonStyle}" Click="BtnReplaySpeed_Click" Tag="2"   Width="56" Margin="0,0,2,0" ToolTip="5× real-time">5×</Button>
                                    <Button Style="{StaticResource ToolsButtonStyle}" Click="BtnReplaySpeed_Click" Tag="0"   Width="50"                  ToolTip="No delay">Max</Button>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ── Parameters (collapsible, bottom) ─────────────────────────── -->
                    <Border Background="#E8F5E9" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                        <Expander Header="Parameters" IsExpanded="{Binding ParamsPanelVisible, Mode=TwoWay}">
                            <StackPanel Margin="0,8,0,0">
                                <!-- 1. Stomp threshold -->
                                <TextBlock Text="{Binding StompThreshold, StringFormat='Stomp Threshold: {0:F0} m/s²'}" FontSize="11"/>
                                <Slider Minimum="10" Maximum="50" SmallChange="1" LargeChange="5"
                                        Value="{Binding StompThreshold, Mode=TwoWay}" Margin="0,0,0,8"/>

                                <!-- 2. Static gyro threshold -->
                                <TextBlock Text="{Binding StaticGyroThreshold, StringFormat='Static Gyro Threshold: {0:F2} rad/s'}" FontSize="11"/>
                                <Slider Minimum="0.05" Maximum="1.0" SmallChange="0.01" LargeChange="0.1"
                                        Value="{Binding StaticGyroThreshold, Mode=TwoWay}" Margin="0,0,0,8"/>

                                <!-- 3. Stance free-acc threshold -->
                                <TextBlock Text="{Binding StanceFreeAccThreshold, StringFormat='Stance Acc Threshold: {0:F1} m/s²'}" FontSize="11"/>
                                <Slider Minimum="0.5" Maximum="5.0" SmallChange="0.1" LargeChange="0.5"
                                        Value="{Binding StanceFreeAccThreshold, Mode=TwoWay}" Margin="0,0,0,8"/>

                                <!-- 4. Stance gyro threshold -->
                                <TextBlock Text="{Binding StanceGyroThreshold, StringFormat='Stance Gyro Threshold: {0:F1} rad/s'}" FontSize="11"/>
                                <Slider Minimum="0.1" Maximum="3.0" SmallChange="0.05" LargeChange="0.2"
                                        Value="{Binding StanceGyroThreshold, Mode=TwoWay}" Margin="0,0,0,8"/>

                                <!-- 5. PD confidence threshold -->
                                <TextBlock Text="{Binding PdConfidenceThreshold, StringFormat='PD Confidence Threshold: {0:F2}'}" FontSize="11"/>
                                <Slider Minimum="0.3" Maximum="1.0" SmallChange="0.01" LargeChange="0.1"
                                        Value="{Binding PdConfidenceThreshold, Mode=TwoWay}" Margin="0,0,0,8"/>

                                <!-- 6. PD stability threshold -->
                                <TextBlock Text="{Binding PdStabilityThreshold, StringFormat='PD Stability Threshold: {0:F2}'}" FontSize="11"/>
                                <Slider Minimum="0.3" Maximum="1.0" SmallChange="0.01" LargeChange="0.1"
                                        Value="{Binding PdStabilityThreshold, Mode=TwoWay}" Margin="0,0,0,8"/>

                                <!-- 7. Min baseline steps -->
                                <TextBlock Text="{Binding MinBaselineSteps, StringFormat='Min Baseline Steps: {0}'}" FontSize="11"/>
                                <Slider Minimum="10" Maximum="50" SmallChange="1" LargeChange="5"
                                        IsSnapToTickEnabled="True" TickFrequency="1"
                                        Value="{Binding MinBaselineSteps, Mode=TwoWay}" Margin="0,0,0,8"/>

                                <!-- 8. Baseline L/R step count imbalance warning threshold -->
                                <TextBlock Text="{Binding BaselineImbalanceRatioThreshold, StringFormat='Baseline Imbalance Ratio: {0:F2}'}" FontSize="11"/>
                                <Slider Minimum="0.3" Maximum="1.0" SmallChange="0.01" LargeChange="0.1"
                                        Value="{Binding BaselineImbalanceRatioThreshold, Mode=TwoWay}" Margin="0,0,0,12"/>

                                <Button x:Name="BtnSaveParams" Style="{StaticResource ParamsButtonStyle}" Click="BtnSaveParams_Click"
                                        HorizontalAlignment="Stretch"
                                        ToolTip="Persist current parameter values to disk">
                                    Save Params
                                </Button>
                            </StackPanel>
                        </Expander>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ── LEFT PANEL — Grid with resizable log row ─────────────────────── -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>                             <!-- Row 0: status grid -->
                <RowDefinition Height="Auto"/>                             <!-- Row 1: timeline -->
                <RowDefinition x:Name="SplitterRow" Height="5"/>           <!-- Row 2: drag handle -->
                <RowDefinition x:Name="LogRow" Height="*" MinHeight="60"/> <!-- Row 3: log (now gets all freed space) -->
            </Grid.RowDefinitions>

            <!-- Row 0: Status grid -->
            <Grid Grid.Row="0" Margin="8,6,8,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Col 0: System status -->
                <Border Grid.Column="0" Padding="10" CornerRadius="6" Background="#11000000" Margin="0,0,4,0">
                    <StackPanel>
                        <TextBlock Text="{Binding DeviceState}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding StatusLabel}" FontSize="16" FontWeight="Bold"
                                   Margin="0,4,0,8" TextWrapping="Wrap"/>
                        <UniformGrid Columns="2">
                            <TextBlock Text="Calib State:" Opacity="0.7" FontSize="11"/>
                            <TextBlock Text="{Binding CalibrationState}" FontSize="11"/>
                            <TextBlock Text="Prog Dir:" Opacity="0.7" FontSize="11"/>
                            <TextBlock Text="{Binding ProgDirDeg, StringFormat={}{0:F1}°}" FontSize="11"/>
                            <TextBlock Text="Gate Reject:" Opacity="0.7" FontSize="11"/>
                            <TextBlock Text="{Binding PelvisRejectStreak}" FontSize="11"/>
                            <TextBlock Text="Gait:" Opacity="0.7" FontSize="11"/>
                            <TextBlock Text="{Binding StanceSummary}" FontSize="11" TextWrapping="Wrap"/>
                        </UniformGrid>

                        <!-- IMU connection indicators -->
                        <StackPanel Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="PelvisStatusDot" Width="10" Height="10" Fill="Gray"
                                         Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="PelvisStatusText" Text="Pelvis: --" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <Ellipse x:Name="LeftStatusDot" Width="10" Height="10" Fill="Gray"
                                         Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="LeftStatusText" Text="Left: --" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <Ellipse x:Name="RightStatusDot" Width="10" Height="10" Fill="Gray"
                                         Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="RightStatusText" Text="Right: --" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Col 1: Left FPA -->
                <Border Grid.Column="1" Padding="10" CornerRadius="6"
                        Background="{Binding LeftFpaBackground}" Margin="4,0">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Left FPA" FontSize="14" Opacity="0.75" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding LeftFpaDeg, StringFormat={}{0:F1}°}"
                                   FontSize="48" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding LeftFpaTarget}" FontSize="12" Opacity="0.8" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding LeftFpaNote}" Opacity="0.7" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Col 2: Right FPA -->
                <Border Grid.Column="2" Padding="10" CornerRadius="6"
                        Background="{Binding RightFpaBackground}" Margin="4,0,0,0">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Right FPA" FontSize="14" Opacity="0.75" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding RightFpaDeg, StringFormat={}{0:F1}°}"
                                   FontSize="48" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding RightFpaTarget}" FontSize="12" Opacity="0.8" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding RightFpaNote}" Opacity="0.7" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Row 1: Timeline panel -->
            <Border Grid.Row="1" x:Name="TimelineBorder"  Background="#1E1E1E" Margin="0 10 0 0"
                    SizeChanged="TimelineBorder_SizeChanged">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Top">
                        <TextBlock Text="PdValid"  Foreground="#888" Height="16" VerticalAlignment="Center" Margin="2,0"/>
                        <TextBlock Text="L.Stance" Foreground="#888" Height="16" VerticalAlignment="Center" Margin="2,0"/>
                        <TextBlock Text="R.Stance" Foreground="#888" Height="16" VerticalAlignment="Center" Margin="2,0"/>
                        <TextBlock Text="Walking"  Foreground="#888" Height="16" VerticalAlignment="Center" Margin="2,0"/>
                        <TextBlock Text="MotionCtx" Foreground="#888" Height="16" VerticalAlignment="Center" Margin="2,0"/>
                        <TextBlock Text="FPA"      Foreground="#888" Height="16" VerticalAlignment="Center" Margin="2,0"/>
                    </StackPanel>
                    <Image x:Name="TimelineImage" Grid.Column="1"
                           Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                </Grid>
            </Border>

            <!-- Row 2: GridSplitter — drag up/down to resize log -->
            <GridSplitter Grid.Row="2"
                          Height="5"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="#33000000"
                          ShowsPreview="True"
                          ResizeDirection="Rows"
                          ResizeBehavior="PreviousAndNext"
                          Visibility="{Binding LogPanelVisible, Converter={StaticResource BoolToVis}}"/>

            <!-- Row 3: Log panel — left: debug log, right: AR feedback event log (cue + timestamp) -->
            <Grid Grid.Row="3" Visibility="{Binding LogPanelVisible, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0" Margin="8,0,4,2">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,2">
                        <TextBlock Text="Debug Log" FontSize="11" Foreground="Gray" VerticalAlignment="Center"/>
                        <Button Content="Clear" Click="btnClear" Padding="6,0" Margin="8,0,0,0"/>
                    </StackPanel>
                    <TextBox
                        x:Name="LogBox"
                        AcceptsReturn="True"
                        IsReadOnly="True"
                        Text="{Binding LogList}"
                        TextWrapping="NoWrap"
                        FontFamily="Consolas"
                        FontSize="12"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto"/>
                </DockPanel>

                <GridSplitter Grid.Column="1"
                              Width="5"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="#33000000"
                              ShowsPreview="True"/>

                <DockPanel Grid.Column="2" Margin="4,0,8,2">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,2">
                        <TextBlock Text="AR Feedback Events (cue + timestamp)" FontSize="11" Foreground="Gray" VerticalAlignment="Center"/>
                        <Button Content="Clear" Click="BtnClearArLog_Click" Padding="6,0" Margin="8,0,0,0"/>
                    </StackPanel>
                    <TextBox
                        x:Name="ArEventLogBox"
                        AcceptsReturn="True"
                        IsReadOnly="True"
                        Text="{Binding ArEventLog}"
                        TextWrapping="NoWrap"
                        FontFamily="Consolas"
                        FontSize="12"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto"/>
                </DockPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
